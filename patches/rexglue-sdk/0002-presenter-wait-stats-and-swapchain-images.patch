+// Beatles recomp patch: time spent blocking in the paint path, for the host app's
+// --perf_log. rex_presenter_take_wait_stats returns and resets the totals
+// {paints, await_ns, acquire_ns, present_ns}.
+namespace {
+std::atomic<uint64_t> g_paint_stats[4];
+uint64_t PaintNowNs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+}  // namespace
+extern "C" __attribute__((visibility("default"))) void rex_presenter_take_wait_stats(
+    uint64_t out[4]) {
+  for (int i = 0; i < 4; ++i) out[i] = g_paint_stats[i].exchange(0, std::memory_order_relaxed);
+}
