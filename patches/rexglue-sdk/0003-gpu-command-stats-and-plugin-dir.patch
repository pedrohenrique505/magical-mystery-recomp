+
+// Returns the counters accumulated since the previous call and resets them. Writes at most
+// `count` values (layout: rex::graphics::vulkan::GpuStatSlot); returns the number of slots.
+extern "C" __attribute__((visibility("default"))) size_t rex_gpu_take_command_stats(
+    uint64_t* out, size_t count) {
+  using namespace rex::graphics::vulkan;
+  for (size_t i = 0; i < kGpuStatSlotCount && i < count; ++i) {
+    out[i] = g_gpu_stats[i].exchange(0, std::memory_order_relaxed);
+  }
+  return kGpuStatSlotCount;
+}
