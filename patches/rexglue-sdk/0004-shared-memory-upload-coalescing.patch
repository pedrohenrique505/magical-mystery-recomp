+// beatles patch 0004: when a draw needs pages that the CPU has written, also upload the
+// invalid pages right next to them (up to this many KB on each side). Dynamic vertex and
+// constant data is usually written for a whole frame before the GPU reads it piecewise; one
+// larger upload replaces many small ones, and each upload costs a pipeline barrier and, in
+// Vulkan, the end of the current render pass. Pages the CPU writes again later are
+// invalidated and re-uploaded on use as before. 0 disables it.
+REXCVAR_DEFINE_UINT32(shared_memory_upload_coalesce_kb, 0, "GPU",
+                      "Extend shared memory uploads into adjacent CPU-written pages, in KB per "
+                      "side (0 = off)");
