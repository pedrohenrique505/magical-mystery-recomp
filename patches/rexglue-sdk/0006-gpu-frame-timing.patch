 namespace rex::graphics::vulkan {
 
+// beatles patch 0006: per-frame host GPU timing.
+//
+// When the host app calls rex_gpu_frame_timing_enable(), every submission gets a timestamp
+// at the start and at the end of its command buffer. Once the GPU has finished a frame (all
+// submissions recorded while that guest frame was open), a record with the GPU start/end
+// times, the summed submission time and the per-frame deltas of the GpuStatSlot counters is
+// queued for rex_gpu_take_frame_records(). Presenter paints use the same queue but are not
+// timed, so they show up as the gap between frames.
+namespace beatles_frame_timer {
+
+// Keep in sync with the host app (project/src/gpu_frame_log.cpp).
+struct FrameRecord {
+  uint64_t frame;         // host frame index (VulkanCommandProcessor::frame_current_)
+  uint64_t gpu_start_ns;  // GPU clock, first timed submission of the frame started
+  uint64_t gpu_end_ns;    // GPU clock, last timed submission of the frame ended
+  uint64_t busy_ns;       // sum of the submissions' durations
+  uint64_t cpu_close_ns;  // steady_clock when the CPU closed the frame (0 = unknown)
+  uint32_t submissions;
+  uint32_t stat_count;    // valid entries in stats (kGpuStatSlotCount)
+  uint64_t stats[48];     // per-frame GpuStatSlot deltas
+  uint64_t category_ns[8];  // GPU time per GpuTimeCategory (0 unless category timing is on)
+  uint32_t category_spans[8];
+};
+static_assert(kGpuStatSlotCount <= 48);
+static_assert(kGpuTimeCategoryCount <= 8);
+
+// Each in-flight submission owns a block of queries: [0] start, [1] end, then markers.
+constexpr uint32_t kQuerySlots = 64;  // submissions in flight that can be timed
+constexpr uint32_t kQueriesPerSlot = 2048;
+constexpr uint32_t kFrameRing = 16;    // frames whose counters wait for their GPU times
+constexpr size_t kMaxQueuedRecords = 4096;
+
+struct Marker {
+  uint32_t category;  // GpuTimeCategory | profile key << 8
+  bool end;
+};
+
+// Render-target transfer profile (GpuTransferProfileKey): per description, draws and tiles
+// counted at record time, GPU time added when the spans complete. Logged every
+// kProfileLogFrames frames, then reset.
+constexpr uint64_t kProfileLogFrames = 600;
+struct TransferProfileEntry {
+  std::string description;
+  uint64_t draws = 0;
+  uint64_t tiles = 0;
+  uint64_t ns = 0;
+};
+
+struct Pending {
+  uint64_t submission;
+  uint32_t slot;
+  uint64_t frame;
+  std::vector<Marker> markers;  // query 2 + i
+};
+
+struct State {
+  std::atomic<bool> enabled{false};
+  std::atomic<bool> categories{false};
+  // GPU command thread only.
+  uint32_t current_slot = UINT32_MAX;  // slot of the command buffer being recorded
+  std::vector<Marker> current_markers;
+  bool category_skipping[kGpuTimeCategoryCount] = {};
+  std::vector<uint64_t> results;
+  std::vector<TransferProfileEntry> transfer_profile;  // index = key - 1
+  std::unordered_map<std::string, uint32_t> transfer_profile_index;
+  uint64_t profile_frames = 0;
+  bool init_tried = false;
+  VkDevice device = VK_NULL_HANDLE;
+  VkQueryPool pool = VK_NULL_HANDLE;
+  PFN_vkCmdWriteTimestamp write_timestamp = nullptr;
+  PFN_vkGetQueryPoolResults get_results = nullptr;
+  PFN_vkCmdResetQueryPool reset_pool = nullptr;
+  double period_ns = 1.0;
+  std::deque<Pending> pending;
+  bool agg_open = false;
+  FrameRecord agg{};
+  uint64_t last_snapshot[kGpuStatSlotCount] = {};
+  uint64_t ring_frame[kFrameRing] = {};
+  uint64_t ring_cpu_ns[kFrameRing] = {};
+  uint64_t ring_stats[kFrameRing][kGpuStatSlotCount] = {};
+  bool ring_valid[kFrameRing] = {};
+  // Shared with the reader.
+  std::mutex mutex;
+  std::deque<FrameRecord> records;
+};
+
+State& S() {
+  static State s;
+  return s;
+}
+
+bool Init(const ui::vulkan::VulkanDevice* vulkan_device) {
+  State& s = S();
+  if (s.init_tried) return s.pool != VK_NULL_HANDLE;
+  s.init_tried = true;
+  const auto& ifn = vulkan_device->vulkan_instance()->functions();
+  const auto& dfn = vulkan_device->functions();
+  VkDevice device = vulkan_device->device();
+  s.write_timestamp =
+      PFN_vkCmdWriteTimestamp(ifn.vkGetDeviceProcAddr(device, "vkCmdWriteTimestamp"));
+  s.get_results =
+      PFN_vkGetQueryPoolResults(ifn.vkGetDeviceProcAddr(device, "vkGetQueryPoolResults"));
+  s.reset_pool = dfn.vkCmdResetQueryPool;
+  VkPhysicalDeviceProperties properties;
+  ifn.vkGetPhysicalDeviceProperties(vulkan_device->physical_device(), &properties);
+  s.period_ns = properties.limits.timestampPeriod;
+  if (!s.write_timestamp || !s.get_results || !s.reset_pool || s.period_ns <= 0.0) {
+    REXGPU_WARN("GPU frame timing: timestamp queries unavailable");
+    return false;
+  }
+  VkQueryPoolCreateInfo pool_info = {};
+  pool_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+  pool_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+  pool_info.queryCount = kQuerySlots * kQueriesPerSlot;
+  if (dfn.vkCreateQueryPool(device, &pool_info, nullptr, &s.pool) != VK_SUCCESS) {
+    s.pool = VK_NULL_HANDLE;
+    REXGPU_WARN("GPU frame timing: failed to create the timestamp query pool");
+    return false;
+  }
+  s.device = device;
+  REXGPU_INFO("GPU frame timing enabled (timestamp period {} ns)", s.period_ns);
+  return true;
+}
+
+// Before the deferred commands of a submission: returns the query slot, or UINT32_MAX.
+uint32_t BeginSubmission(const ui::vulkan::VulkanDevice* vulkan_device, VkCommandBuffer cb,
+                         uint64_t submission) {
+  State& s = S();
+  if (!s.enabled.load(std::memory_order_relaxed) || !Init(vulkan_device)) return UINT32_MAX;
+  if (!s.pending.empty() && submission - s.pending.front().submission >= kQuerySlots) {
+    return UINT32_MAX;  // the GPU is too far behind; leave this one untimed
+  }
+  const uint32_t slot = uint32_t(submission % kQuerySlots);
+  const bool categories = s.categories.load(std::memory_order_relaxed);
+  s.reset_pool(cb, s.pool, slot * kQueriesPerSlot, categories ? kQueriesPerSlot : 2);
+  s.write_timestamp(cb, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, s.pool, slot * kQueriesPerSlot);
+  s.current_slot = categories ? slot : UINT32_MAX;
+  s.current_markers.clear();
+  std::fill(std::begin(s.category_skipping), std::end(s.category_skipping), false);
+  return slot;
+}
+
+// A CmdBeatlesTimestamp marker being executed into `cb`. Both ends of a span use
+// BOTTOM_OF_PIPE, so a span measures the time from all earlier work being done to the
+// marked work being done (the work is already serialized by barriers in most cases).
+void RecordMarker(VkCommandBuffer cb, uint32_t category, bool end) {
+  State& s = S();
+  const uint32_t key = category >> 8;
+  category &= 0xFF;
+  if (s.current_slot == UINT32_MAX || category >= kGpuTimeCategoryCount) return;
+  if (!end && s.current_markers.size() + 2 + 2 > kQueriesPerSlot) {
+    s.category_skipping[category] = true;  // out of queries: drop this span
+    return;
+  }
+  if (end && s.category_skipping[category]) {
+    s.category_skipping[category] = false;
+    return;
+  }
+  const uint32_t query = s.current_slot * kQueriesPerSlot + 2 + uint32_t(s.current_markers.size());
+  s.write_timestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, s.pool, query);
+  s.current_markers.push_back({category | (key << 8), end});
+}
+
+void EndSubmission(VkCommandBuffer cb, uint32_t slot) {
+  State& s = S();
+  s.current_slot = UINT32_MAX;
+  if (slot == UINT32_MAX) return;
+  s.write_timestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, s.pool, slot * kQueriesPerSlot + 1);
+}
+
+void Submitted(uint32_t slot, uint64_t submission, uint64_t frame) {
+  State& s = S();
+  if (slot == UINT32_MAX) return;
+  s.pending.push_back({submission, slot, frame, std::move(s.current_markers)});
+  s.current_markers.clear();
+}
+
+// The CPU closed `frame`: store its counter deltas until its GPU times are known.
+void FrameClosed(uint64_t frame) {
+  State& s = S();
+  if (!s.enabled.load(std::memory_order_relaxed)) return;
+  uint64_t now[kGpuStatSlotCount];
+  GpuStatSnapshot(now);
+  const uint32_t i = uint32_t(frame % kFrameRing);
+  s.ring_frame[i] = frame;
+  s.ring_valid[i] = true;
+  s.ring_cpu_ns[i] = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                  std::chrono::steady_clock::now().time_since_epoch())
+                                  .count());
+  for (size_t j = 0; j < kGpuStatSlotCount; ++j) {
+    s.ring_stats[i][j] = now[j] - s.last_snapshot[j];
+    s.last_snapshot[j] = now[j];
+  }
+}
+
+void LogTransferProfile(State& s) {
+  std::vector<const TransferProfileEntry*> entries;
+  uint64_t total_ns = 0;
+  for (const TransferProfileEntry& e : s.transfer_profile) {
+    total_ns += e.ns;
+    if (e.draws) entries.push_back(&e);
+  }
+  std::sort(entries.begin(), entries.end(),
+            [](const auto* a, const auto* b) { return a->ns > b->ns; });
+  const double frames = double(s.profile_frames);
+  REXGPU_INFO("transfer profile: {} frames, {:.2f} ms/frame in {} kinds of transfer",
+              s.profile_frames, total_ns / 1e6 / frames, entries.size());
+  for (size_t i = 0; i < entries.size() && i < 20; ++i) {
+    const TransferProfileEntry& e = *entries[i];
+    REXGPU_INFO("transfer profile:   {:6.3f} ms/frame {:6.2f} draws/frame {:8.1f} tiles/frame  {}",
+                e.ns / 1e6 / frames, e.draws / frames, e.tiles / frames, e.description);
+  }
+  for (TransferProfileEntry& e : s.transfer_profile) {
+    e.draws = e.tiles = e.ns = 0;
+  }
+  s.profile_frames = 0;
+}
+
+void Finalize(State& s) {
+  if (!s.agg_open) return;
+  s.agg_open = false;
+  if (s.categories.load(std::memory_order_relaxed) && ++s.profile_frames >= kProfileLogFrames) {
+    LogTransferProfile(s);
+  }
+  const uint32_t i = uint32_t(s.agg.frame % kFrameRing);
+  s.agg.stat_count = uint32_t(kGpuStatSlotCount);
+  if (s.ring_valid[i] && s.ring_frame[i] == s.agg.frame) {
+    s.agg.cpu_close_ns = s.ring_cpu_ns[i];
+    std::memcpy(s.agg.stats, s.ring_stats[i], sizeof(s.ring_stats[i]));
+    s.ring_valid[i] = false;
+  }
+  std::lock_guard<std::mutex> guard(s.mutex);
+  if (s.records.size() >= kMaxQueuedRecords) s.records.pop_front();
+  s.records.push_back(s.agg);
+}
+
+// Reads the timestamps of the submissions the GPU has completed.
+void Collect(uint64_t submission_completed) {
+  State& s = S();
+  while (!s.pending.empty() && s.pending.front().submission <= submission_completed) {
+    const Pending& p = s.pending.front();
+    const uint32_t count = 2 + uint32_t(p.markers.size());
+    s.results.resize(count);
+    const VkResult result =
+        s.get_results(s.device, s.pool, p.slot * kQueriesPerSlot, count,
+                      count * sizeof(uint64_t), s.results.data(), sizeof(uint64_t),
+                      VK_QUERY_RESULT_64_BIT);
+    if (result == VK_NOT_READY) break;
+    const Pending done = std::move(s.pending.front());
+    s.pending.pop_front();
+    if (result != VK_SUCCESS) continue;
+    const uint64_t* ts = s.results.data();
+    const uint64_t start = uint64_t(double(ts[0]) * s.period_ns);
+    const uint64_t end = uint64_t(double(ts[1]) * s.period_ns);
+    // Pair each span start with the next end of the same category.
+    uint64_t category_ns[kGpuTimeCategoryCount] = {};
+    uint32_t category_spans[kGpuTimeCategoryCount] = {};
+    uint64_t open_at[kGpuTimeCategoryCount] = {};
+    bool open[kGpuTimeCategoryCount] = {};
+    for (size_t i = 0; i < done.markers.size(); ++i) {
+      const Marker m = done.markers[i];
+      if (!m.end) {
+        open[m.category & 0xFF] = true;
+        open_at[m.category & 0xFF] = ts[2 + i];
+      } else if (open[m.category & 0xFF]) {
+        const uint32_t c = m.category & 0xFF;
+        open[c] = false;
+        if (ts[2 + i] > open_at[c]) {
+          const uint64_t ns = uint64_t(double(ts[2 + i] - open_at[c]) * s.period_ns);
+          category_ns[c] += ns;
+          const uint32_t key = m.category >> 8;
+          if (key && key <= s.transfer_profile.size()) s.transfer_profile[key - 1].ns += ns;
+        }
+        ++category_spans[c];
+      }
+    }
+    const Pending& p2 = done;
+    if (s.agg_open && p2.frame != s.agg.frame) Finalize(s);
+    if (!s.agg_open) {
+      s.agg = FrameRecord{};
+      s.agg.frame = p2.frame;
+      s.agg.gpu_start_ns = start;
+      s.agg_open = true;
+    }
+    s.agg.gpu_end_ns = std::max(s.agg.gpu_end_ns, end);
+    s.agg.busy_ns += end > start ? end - start : 0;
+    ++s.agg.submissions;
+    for (uint32_t c = 0; c < kGpuTimeCategoryCount; ++c) {
+      s.agg.category_ns[c] += category_ns[c];
+      s.agg.category_spans[c] += category_spans[c];
+    }
+  }
+}
+
+}  // namespace beatles_frame_timer
+
+bool GpuCategoryTimingEnabled() {
+  return beatles_frame_timer::S().categories.load(std::memory_order_relaxed);
+}
+
+void GpuCategoryTimestamp(VkCommandBuffer command_buffer, uint32_t category, bool end) {
+  beatles_frame_timer::RecordMarker(command_buffer, category, end);
+}
+
+uint32_t GpuTransferProfileKey(const char* description, uint32_t tiles) {
+  auto& s = beatles_frame_timer::S();
+  auto [it, inserted] =
+      s.transfer_profile_index.try_emplace(description, uint32_t(s.transfer_profile.size() + 1));
+  if (inserted) s.transfer_profile.push_back({description});
+  auto& entry = s.transfer_profile[it->second - 1];
+  ++entry.draws;
+  entry.tiles += tiles;
+  return it->second;
+}
+
+}  // namespace rex::graphics::vulkan
+
+extern "C" __attribute__((visibility("default"))) void rex_gpu_frame_timing_enable() {
+  rex::graphics::vulkan::beatles_frame_timer::S().enabled.store(true);
+}
+
+// Also time GpuTimeCategory spans (more timestamps, each a pipeline drain; small overhead).
+extern "C" __attribute__((visibility("default"))) void rex_gpu_category_timing_enable() {
+  rex::graphics::vulkan::beatles_frame_timer::S().categories.store(true);
+}
+
+// Moves up to `max` finished frame records (beatles_frame_timer::FrameRecord) to `out`;
+// returns how many were written. Callable from any thread.
+extern "C" __attribute__((visibility("default"))) size_t rex_gpu_take_frame_records(
+    void* out, size_t max) {
+  using namespace rex::graphics::vulkan::beatles_frame_timer;
+  State& s = S();
+  std::lock_guard<std::mutex> guard(s.mutex);
+  size_t n = 0;
+  auto* records = static_cast<FrameRecord*>(out);
+  while (n < max && !s.records.empty()) {
+    records[n++] = s.records.front();
+    s.records.pop_front();
+  }
+  return n;
+}
